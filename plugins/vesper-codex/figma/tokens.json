{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "canvas": { "$type": "color", "$value": "#f5f5f7" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "text": { "$type": "color", "$value": "#1d1d1f" },
    "secondary": { "$type": "color", "$value": "#6e6e73" },
    "tertiary": { "$type": "color", "$value": "#86868b" },
    "border": { "$type": "color", "$value": "#e5e5e7" },
    "buy": { "$type": "color", "$value": "#16834a" },
    "sell": { "$type": "color", "$value": "#c43a34" },
    "warning": { "$type": "color", "$value": "#a76500" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "8px" },
    "control": { "$type": "dimension", "$value": "7px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "typography": {
    "body": { "$type": "fontFamily", "$value": "-apple-system, BlinkMacSystemFont, Inter, sans-serif" },
    "metric": { "$type": "number", "$value": 27 },
    "heading": { "$type": "number", "$value": 18 }
  },
  "component": {
    "position-marker": {
      "size-min": { "$type": "number", "$value": 6 },
      "size-max": { "$type": "number", "$value": 14 }
    },
    "sidebar": {
      "width": { "$type": "dimension", "$value": "236px" }
    }
  }
}
